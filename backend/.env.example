# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
DATABASE_URL=postgres://globe:change-me@localhost:5432/globe

# Signs access tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=globe-api
JWT_AUDIENCE=globe-web

ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=7
SESSION_TTL_DAYS=30
AUTH_RATE_LIMIT=10

# Comma-separated origins of the web application, for CORS and CSRF.
WEB_ORIGINS=http://localhost:5173

# Keep true. Browsers accept Secure cookies from http://localhost.
COOKIE_SECURE=true

# Serves the API documentation at /api/docs. Leave off in production.
SWAGGER_ENABLED=true

# Seeding only: the password given to every seeded account. At least 12 characters.
SEED_PASSWORD=
